# =====================================================================
# allin1site Mini Games — Environment Variables Template
# =====================================================================
# CÁCH DÙNG:
#   1. Trên VPS:  cp .env.example .env
#   2. Mở .env, điền giá trị thật vào những chỗ ghi  ← FILL HERE
#   3. chmod 600 .env   (quan trọng: chỉ owner đọc được)
#   4. docker compose up -d --build
#
# ⚠️  TUYỆT ĐỐI KHÔNG commit file .env (đã có trong .gitignore)
# ⚠️  Mỗi lần đổi .env phải `docker compose up -d` lại để áp dụng
# =====================================================================


# ─── 1. MySQL connection ─────────────────────────────────────────────
# Format:   mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Ví dụ:    mysql://root:abc123@db.example.com:3306/minigame
#
#  ← FILL HERE: connection string MySQL của anh
#     - DB phải tồn tại sẵn (schema sẽ tự tạo bảng từ api/schema.sql)
#     - Tài khoản cần quyền: SELECT, INSERT, UPDATE, CREATE
#     - Nếu password có ký tự đặc biệt (@ # $ %), phải URL-encode:
#         @ → %40    # → %23    $ → %24    space → %20
DATABASE_URL=


# ─── 2. SSL cho MySQL ────────────────────────────────────────────────
#  ← FILL HERE: "true" nếu MySQL ở cloud (Aiven, PlanetScale, AWS RDS, Vercel MySQL)
#               "false" nếu MySQL ở localhost / cùng VPS
MYSQL_SSL=true


# ─── 3. Google OAuth Client ID ───────────────────────────────────────
# Cần để bật nút "Sign in with Google".
# Lấy ở: https://console.cloud.google.com/apis/credentials
#   1. Create Credentials → OAuth 2.0 Client ID → Web application
#   2. Authorized JavaScript origins: thêm
#        https://minigames.allin1site.com
#        http://localhost:3000   (cho test local)
#   3. Copy "Client ID" (chuỗi dạng *.apps.googleusercontent.com)
#
# Đây là PUBLIC ID (không phải secret), an toàn để lộ.
# Để TRỐNG nếu chưa cần Google login (game vẫn chạy guest mode bình thường).
#
#  ← FILL HERE: Client ID Google của anh, hoặc để trống
GOOGLE_CLIENT_ID=


# ─── 4. CORS — domain được phép gọi /api/* ───────────────────────────
# Ví dụ:
#   *                                    (mở cho mọi domain — DEV)
#   https://minigames.allin1site.com     (chỉ domain chính — PROD recommend)
#
#  ← FILL HERE: production thì đổi sang domain thật
CORS_ORIGIN=https://minigames.allin1site.com


# ─── 5. Server port (KHÔNG CẦN ĐỔI nếu dùng nginx reverse proxy) ─────
# Express bind vào 0.0.0.0:PORT. nginx upstream trỏ http://127.0.0.1:PORT.
# Đổi nếu port 3000 bị xung đột với app khác trên cùng VPS.
PORT=3000


# ─── 6. NODE_ENV (KHÔNG CẦN ĐỔI) ─────────────────────────────────────
NODE_ENV=production


# =====================================================================
# CHECKLIST sau khi điền:
#   [ ] DATABASE_URL đã đổi từ "USER:PASSWORD@HOST" thành thật
#   [ ] MYSQL_SSL đúng (true/false)
#   [ ] GOOGLE_CLIENT_ID đã điền (hoặc để trống có chủ đích)
#   [ ] CORS_ORIGIN đổi sang https://minigames.allin1site.com
#   [ ] chmod 600 .env
#   [ ] mysql ... < api/schema.sql  (chạy 1 lần để tạo bảng)
#   [ ] docker compose up -d --build
#   [ ] curl http://127.0.0.1:3000/healthz  →  {"ok":true,...}
#   [ ] curl 'http://127.0.0.1:3000/api/stats?all=1'  →  {"games":[...]}
# =====================================================================
