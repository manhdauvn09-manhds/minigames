      "subdomain": "penumbra.allin1site.com",
      "parentDomain": "allin1site.com",
      "runtimeMode": "nextjs-standalone-node-behind-nginx",
      "containerPort": 3000,
      "tlsTermination": "nginx + Let's Encrypt (matches Sodoku pattern)",
      "siblingSubapp": "sodoku.allin1site.com",
      "cron": [
        {
          "path": "/api/cron/daily-generate",
          "schedule": "50 23 * * *",
          "executor": "APScheduler in Crawler&Admin BE container (calls penumbra:3000/api/cron/daily-generate with CRON_SECRET) — Vercel cron not used on self-host"
        }
      ]
    },
    "testing": {
      "unit": "Vitest",
      "component": "Vitest + React Testing Library",
      "e2e": "Playwright",
      "engineCoverageTarget": 0.9
    },
    "errorTracking": "Sentry",
    "analytics": "PostHog (cookieless, IP anonymized)",
    "schemaNotes": [
      "plays table: add nullable column `best_path jsonb` to store the winning path for phantom display. Also add `path_score integer` (computed: stars*1000 - duration_ms/1000 - hints_used*200) for ranking. Cron job selects top path_score per puzzle per day and caches in `daily_phantom` table."
    ],
    "additionalTables": [
      {
        "name": "daily_phantoms",
        "purpose": "Cache the top-scoring path per puzzle per UTC day for phantom display",
        "columns": [
          "puzzle_id uuid references puzzles(id)",
          "date date",
          "path jsonb not null  -- [{ row, col }, ...]",
          "path_score integer not null",
          "created_at timestamptz default now()",
          "PRIMARY KEY (puzzle_id, date)"
        ],
        "rls": "public read (no auth required)",
        "populatedBy": "cron job at 00:05 UTC (5 min after daily rollover)"
      }
    ],
    "additionalEndpoints": [
      {
        "method": "GET",
        "path": "/api/phantom/[puzzleId]",
        "auth": "none",
        "description": "Returns the top-scoring path for a puzzle on a given date (yesterday for daily puzzles, all-time best for levels). Used to render the phantom overlay on result screen.",
        "queryParams": {
          "date": "YYYY-MM-DD (optional, defaults to yesterday UTC)"
        },
        "response200": {
          "path": "[{ row: number, col: number }] | null"
        },
        "cacheControl": "public, max-age=3600 (changes once per day)"
      }
    ],
    "analyticsEvents": [
      "phantom_viewed"
    ]
  },
  "ai": {
    "hintExplainer": {
      "model": "claude-sonnet-4",
      "endpoint": "/api/hint/explain",
      "transport": "server-sent-events",
      "promptTemplate": "You are a quiet puzzle coach for the game Penumbra. The player is stuck on a path-drawing puzzle.\n\nGame rules:\n- Draw a continuous orthogonal path between two lanterns.\n- The path must include all bright cells.\n- The path must avoid all void cells.\n- The path may not cross itself.\n\nCurrent board (JSON, row-major):\n{{board_json}}\n\nThe correct solution path (JSON, do NOT reveal directly):\n{{solution_path_json}}\n\nThe player's current path (JSON):\n{{current_path_json}}\n\nThe player's recent moves (JSON):\n{{recent_moves_json}}\n\nYour task:\n1. Identify the wrong assumption or pattern the player is missing.\n2. Describe one concrete observation about the current board state that nudges them toward progress.\n3. Do NOT give the next correct cell directly. Hint at the principle, not the move.\n4. Keep the response under 60 words. Conversational and encouraging tone.\n5. Match the player's quiet, contemplative game vibe — no exclamation marks, no \"you got this!\".\n\nRespond in {{user_locale}} (one of: vi, en, ja).",
      "responseLocale": "user.locale",
      "wordLimit": 60,
      "fallbackToDeterministic": true,
      "perUserDailyCap": 5,
      "perAnonSessionDailyCap": 2,
      "globalRateLimitRps": 10,
      "estimatedCostPerCallUsd": 0.005
    },
    "adaptiveDifficulty": {
      "method": "elo-style",
      "recalcEveryNLevels": 5,
      "skillRange": [
        1,
        10
      ],
      "preferredDifficultyOffset": [
        -1,
        1
      ],
      "kFactor": 0.5,
      "expectedFormula": "1 / (1 + 10^((puzzleDifficulty - skill) / 4))"
    },
    "difficultyClassifier": {
      "model": "claude-haiku-4-5",
      "purpose": "Classify AI-generated puzzles 1-10 before persisting"
    }
  },
